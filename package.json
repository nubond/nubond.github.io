{
  "name": "@nubond/docs",
  "description": "Interactive nuBond documentation: short explanations and live, editable examples - built with nuBond itself",
  "author": "Dmytro Tomayly",
  "license": "MIT",
  "private": true,
  "nubond": {
    "languageService": true
  },
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "check": "node scripts/build-content.mjs && tsc --noEmit -p tsconfig.json && tsc --noEmit -p content/tsconfig.json",
    "prestart": "node scripts/clean.mjs dist",
    "start": "node scripts/build-content.mjs --watch -- parcel src/index.html src/sandbox.html",
    "prebuild": "node scripts/build-content.mjs && node scripts/clean.mjs dist .parcel-cache",
    "build": "parcel build src/index.html src/sandbox.html --no-source-maps --public-url ./"
  },
  "devDependencies": {
    "@nubond/posthtml-value-interpolation": "^1.0.3",
    "@parcel/transformer-inline-string": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@parcel/transformer-typescript-tsc": "^2.16.4",
    "@types/node": "^25.9.9",
    "parcel": "^2.16.4",
    "posthtml": "^0.16.7",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "nubond": "^1.0.12"
  }
}
